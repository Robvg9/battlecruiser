{
  "name": "battlecruiser",
  "main": "./preview-worker.mjs",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/app.js",
      "/service-worker.js",
      "/style.css",
      "/__bc_preview/*"
    ]
  }
}
